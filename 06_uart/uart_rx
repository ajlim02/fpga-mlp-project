`timescale 1ns/1ps
`default_nettype none
// 8N1, LSB first, two-flop synchronization and mid-bit sampling.
// A bad stop produces error_o, never valid_o. Both are one-clock pulses.
module uart_rx #(
    parameter integer CLK_FREQ_HZ=100_000_000, BAUD_RATE=115_200,
    parameter integer CLKS_PER_BIT=CLK_FREQ_HZ/BAUD_RATE
)(
    input wire clk, rst_n, rx_i,
    output reg [7:0] data_o,
    output reg valid_o, error_o
);
    localparam integer COUNT_W=(CLKS_PER_BIT>1)?$clog2(CLKS_PER_BIT):1;
    typedef enum logic [2:0] {IDLE,START,DATA,STOP,RECOVER} state_t;
    state_t state;
    (* ASYNC_REG="TRUE" *) reg [1:0] rx_sync;
    reg [COUNT_W-1:0] count;
    reg [2:0] bit_index;
    reg [7:0] shift_reg;
    initial begin
        if (CLKS_PER_BIT<4) $fatal(1,"uart_rx requires CLKS_PER_BIT >= 4");
    end
    always @(posedge clk or negedge rst_n) begin
        if (!rst_n) rx_sync<=2'b11;
        else rx_sync<={rx_sync[0],rx_i};
    end
    always @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            state<=IDLE; count<='0; bit_index<='0; shift_reg<='0;
            data_o<='0; valid_o<=0; error_o<=0;
        end else begin
            valid_o<=0; error_o<=0;
            case (state)
                IDLE: begin count<='0; if (!rx_sync[1]) state<=START; end
                START: begin
                    if (count==COUNT_W'(CLKS_PER_BIT/2-1)) begin
                        count<='0; bit_index<='0;
                        if (!rx_sync[1]) state<=DATA;
                        else state<=IDLE; // Short start glitch.
                    end else count<=count+1'b1;
                end
                DATA: begin
                    if (count==COUNT_W'(CLKS_PER_BIT-1)) begin
                        count<='0; shift_reg[bit_index]<=rx_sync[1];
                        if (bit_index==7) state<=STOP;
                        else bit_index<=bit_index+1'b1;
                    end else count<=count+1'b1;
                end
                STOP: begin
                    if (count==COUNT_W'(CLKS_PER_BIT-1)) begin
                        count<='0;
                        if (rx_sync[1]) begin
                            data_o<=shift_reg; valid_o<=1; state<=IDLE;
                        end else begin error_o<=1; state<=RECOVER; end
                    end else count<=count+1'b1;
                end
                RECOVER: if (rx_sync[1]) state<=IDLE;
                default: state<=IDLE;
            endcase
        end
    end
endmodule
`default_nettype wire
